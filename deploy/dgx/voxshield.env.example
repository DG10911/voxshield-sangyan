# VoxShield secrets template — copy to ~/.config/voxshield.env and fill in.
# NEVER commit the real file (it is gitignored via *.env).
#
#   mkdir -p ~/.config
#   cp deploy/dgx/voxshield.env.example ~/.config/voxshield.env
#   # edit it, then:
#   chmod 600 ~/.config/voxshield.env
#   source deploy/dgx/dgx_setup_env.sh

export HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export BHASHINI_USER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export BHASHINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export BHASHINI_INFERENCE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
